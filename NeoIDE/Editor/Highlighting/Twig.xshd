<?xml version="1.0"?>
<SyntaxDefinition name="Twig" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <!--COLORS-->
  <RuleSet>
    <Span color="Comment" multiline="true" begin="\{\#" end="\#\}"/>
    <Span ruleSet="TwigExpr" multiline="true">
      <Begin color="Delimiter">\{\{-?</Begin>
      <End color="Delimiter">-?\}\}</End>
    </Span>
    <Span ruleSet="TwigExpr" multiline="true">
      <Begin color="Delimiter">\{%-?</Begin>
      <End color="Delimiter">-?%\}</End>
    </Span>
    <Import ruleSet="HtmlMain"/>
  </RuleSet>

  <!--HTML-->

  <RuleSet name="TwigExpr">
    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet><Span begin="\\" end="."/></RuleSet>
    </Span>
    <Span color="String" begin="'" end="'">
      <RuleSet><Span begin="\\" end="."/></RuleSet>
    </Span>
    <Keywords color="Keyword">
      <Word>if</Word><Word>else</Word><Word>elseif</Word><Word>endif</Word><Word>for</Word><Word>endfor</Word>
      <Word>in</Word><Word>block</Word><Word>endblock</Word><Word>extends</Word><Word>include</Word>
      <Word>embed</Word><Word>endembed</Word><Word>set</Word><Word>endset</Word><Word>macro</Word>
      <Word>endmacro</Word><Word>import</Word><Word>from</Word><Word>as</Word><Word>with</Word>
      <Word>endwith</Word><Word>only</Word><Word>is</Word><Word>not</Word><Word>and</Word><Word>or</Word>
      <Word>true</Word><Word>false</Word><Word>null</Word><Word>none</Word><Word>defined</Word>
      <Word>apply</Word><Word>endapply</Word><Word>autoescape</Word><Word>endautoescape</Word>
      <Word>verbatim</Word><Word>endverbatim</Word><Word>use</Word><Word>do</Word><Word>flush</Word>
      <Word>trans</Word><Word>endtrans</Word><Word>sandbox</Word><Word>endsandbox</Word><Word>deprecated</Word>
      <Word>guard</Word><Word>endguard</Word><Word>loop</Word><Word>matches</Word><Word>starts</Word><Word>ends</Word>
    </Keywords>
    <Rule color="FunctionCall">(?&lt;=\|\s*)[A-Za-z_]\w*</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*</Rule>
    <Rule color="FunctionCall">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Variable">\b[A-Za-z_]\w*</Rule>
    <Rule color="Number">\b\d+(\.\d+)?</Rule>
  </RuleSet>
</SyntaxDefinition>
