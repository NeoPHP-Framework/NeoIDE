<?xml version="1.0"?>
<SyntaxDefinition name="ENV" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <!--COLORS-->
  <RuleSet>
    <Span color="Comment" begin="^\s*[\#;]" end="$"/>
    <Rule color="Heading">^\s*\[[^\]]+\]</Rule>
    <Rule color="Keyword">^\s*export(?=\s)</Rule>
    <Rule color="Key">^\s*[\w.\-\[\]]+(?=\s*=)</Rule>
    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet>
        <Span color="StringEscape" begin="\\" end="."/>
        <Rule color="Variable">\$\{?\w+\}?</Rule>
      </RuleSet>
    </Span>
    <Span color="String" begin="'" end="'"/>
    <Rule color="Variable">\$\{?\w+\}?</Rule>
    <Keywords color="Keyword">
      <Word>true</Word><Word>false</Word><Word>null</Word><Word>On</Word><Word>Off</Word>
    </Keywords>
    <Rule color="Number">(?&lt;==\s*)-?\d+(\.\d+)?\s*$</Rule>
    <Rule color="String">(?&lt;==\s*)[^\s#"'$][^#\n]*</Rule>
  </RuleSet>
</SyntaxDefinition>
