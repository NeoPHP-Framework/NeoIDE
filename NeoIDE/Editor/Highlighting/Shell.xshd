<?xml version="1.0"?>
<SyntaxDefinition name="Shell" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <!--COLORS-->
  <RuleSet>
    <Rule color="Metadata">^\#!.*$</Rule>
    <Span color="Comment" begin="(?&lt;=^|\s)\#" end="$"/>
    <Span color="Comment" begin="^\s*(@?rem\s|::)" end="$"/>
    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet>
        <Span color="StringEscape" begin="\\" end="."/>
        <Rule color="Variable">\$\{?[\w@#?*!-]+\}?|%\w+%</Rule>
      </RuleSet>
    </Span>
    <Span color="String" begin="'" end="'"/>
    <Rule color="Variable">\$\{?[\w@#?*!-]+\}?|%~?\w+%?</Rule>
    <Keywords color="Keyword">
      <Word>if</Word><Word>then</Word><Word>else</Word><Word>elif</Word><Word>fi</Word><Word>for</Word>
      <Word>in</Word><Word>do</Word><Word>done</Word><Word>while</Word><Word>until</Word><Word>case</Word>
      <Word>esac</Word><Word>function</Word><Word>return</Word><Word>exit</Word><Word>export</Word><Word>local</Word>
      <Word>echo</Word><Word>set</Word><Word>unset</Word><Word>source</Word><Word>cd</Word><Word>shift</Word>
      <Word>goto</Word><Word>call</Word><Word>setlocal</Word><Word>endlocal</Word><Word>exist</Word><Word>not</Word>
      <Word>RUN</Word><Word>FROM</Word><Word>COPY</Word><Word>ADD</Word><Word>WORKDIR</Word><Word>ENV</Word>
      <Word>EXPOSE</Word><Word>CMD</Word><Word>ENTRYPOINT</Word><Word>ARG</Word><Word>USER</Word><Word>VOLUME</Word>
      <Word>LABEL</Word><Word>AS</Word><Word>HEALTHCHECK</Word><Word>SHELL</Word><Word>ONBUILD</Word>
      <Word>RewriteEngine</Word><Word>RewriteCond</Word><Word>RewriteRule</Word><Word>RewriteBase</Word>
      <Word>Options</Word><Word>DirectoryIndex</Word><Word>Header</Word><Word>Require</Word><Word>AllowOverride</Word>
      <Word>FallbackResource</Word><Word>ErrorDocument</Word>
    </Keywords>
    <Rule color="Tag">&lt;/?\w+[^&gt;]*&gt;</Rule>
    <Rule color="Attribute">(?&lt;=\s)--?[\w-]+</Rule>
    <Rule color="Number">\b\d+\b</Rule>
  </RuleSet>
</SyntaxDefinition>
