<?xml version="1.0"?>
<SyntaxDefinition name="JSON" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <!--COLORS-->
  <RuleSet>
    <Span color="Comment" multiline="true" begin="/\*" end="\*/"/>
    <Span color="Comment" begin="//" end="$"/>
    <Rule color="JsonKey">"(\\.|[^"\\])*"(?=\s*:)</Rule>
    <Span color="String" begin="&quot;" end="&quot;">
      <RuleSet><Span color="StringEscape" begin="\\" end="."/></RuleSet>
    </Span>
    <Keywords color="Keyword">
      <Word>true</Word><Word>false</Word><Word>null</Word>
    </Keywords>
    <Rule color="Number">-?\b\d+(\.\d+)?([eE][+-]?\d+)?</Rule>
  </RuleSet>
</SyntaxDefinition>
