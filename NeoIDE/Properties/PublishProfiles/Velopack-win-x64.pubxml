<?xml version="1.0" encoding="utf-8"?>
<!-- Folder publish packed by Velopack (vpk pack): one file per assembly, so that the update deltas only
     contain the files that really changed. Used by .github/workflows/release.yml and build.ps1 -Pack. -->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <Platform>Any CPU</Platform>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishReadyToRun>true</PublishReadyToRun>
        <DebugType>none</DebugType>
        <PublishDir>..\dist\publish\</PublishDir>
    </PropertyGroup>
</Project>
