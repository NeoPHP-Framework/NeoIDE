<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone NeoIDE.exe: .NET runtime included (no install needed), single file. Used by build.ps1 and by Rider (Publish). -->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <Platform>Any CPU</Platform>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <!-- WPF ships mixed-mode assemblies (DirectWriteForwarder) that cannot load from inside the bundle -->
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishReadyToRun>true</PublishReadyToRun>
        <DebugType>none</DebugType>
        <PublishDir>..\dist\NeoIDE\</PublishDir>
    </PropertyGroup>
</Project>
