<Window x:Class="NeoIDE.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to NeoIDE" Width="860" Height="620" WindowStartupLocation="CenterScreen" Icon="{StaticResource NeoIcon}"
        Background="{DynamicResource WelcomeMainBg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI" FontSize="{DynamicResource UiFontSize}"
        ResizeMode="CanResize" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource WelcomeSideBg}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,48,14,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,24">
                        <Image Source="{StaticResource NeoLogo}" Width="40" Height="40"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NeoIDE" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock x:Name="VersionText" Text="0.1.0" Style="{StaticResource SecondaryText}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="NavList" DockPanel.Dock="Top" SelectedIndex="0" SelectionChanged="Nav_Changed">
                        <ListBoxItem Content="Projects"/>
                        <ListBoxItem Content="Customize"/>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource SecondaryText}" FontSize="11.5" TextWrapping="Wrap"
                               Text="The IDE for the NeoPHP framework"/>
                    <Border/>
                </DockPanel>
            </Border>

            <!-- Window buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="34">
                <Button Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource TitleBarCloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>

            <!-- Projects page -->
            <DockPanel x:Name="ProjectsPage" Grid.Column="1" Margin="24,44,24,20">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="New Project" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="NewProject_Click"/>
                        <Button Content="Open" Margin="8,0,0,0" Click="Open_Click"/>
                        <Button Content="Get from VCS" Margin="8,0,0,0" Click="Clone_Click" ToolTip="git clone a repository"/>
                    </StackPanel>
                    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search projects"/>
                </DockPanel>
                <Grid>
                    <ListBox x:Name="RecentList" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Background="{Binding Color}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="OpenSelected_Click"/>
                                <MenuItem Header="Show in Explorer" Click="Reveal_Click"/>
                                <MenuItem Header="Remove from Recent Projects" Click="RemoveRecent_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Welcome to NeoIDE" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Create a new NeoPHP project to start from scratch." Style="{StaticResource SecondaryText}" Margin="0,8,0,18" HorizontalAlignment="Center"/>
                        <Button Content="New NeoPHP Project" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="NewProject_Click"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- Customize page -->
            <StackPanel x:Name="CustomizePage" Grid.Column="1" Margin="28,48,28,20" Visibility="Collapsed">
                <TextBlock Text="Color theme" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <ComboBox x:Name="ThemeCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="Theme_Changed"/>
                <TextBlock Text="Editor font size" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                <ComboBox x:Name="FontCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="Font_Changed"/>
                <TextBlock Text="PHP interpreters found on this machine" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                <ItemsControl x:Name="PhpList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Style="{StaticResource SecondaryText}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</Window>
