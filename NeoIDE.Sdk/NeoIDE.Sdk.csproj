<Project Sdk="Microsoft.NET.Sdk">
    <!-- Contract between NeoIDE and its plugins. Plugins reference this project with Private="false":
         the assembly is never shipped with a plugin, NeoIDE provides it at runtime. -->
    <PropertyGroup>
        <TargetFramework>net11.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>NeoIDE.Sdk</RootNamespace>
        <Version>1.0.0</Version>
        <!-- The plugins are compiled against this assembly version: it must not follow the IDE version
             (dotnet publish -p:Version=x.y.z of the release applies to every project). Change it only with SdkInfo.Version. -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
</Project>
