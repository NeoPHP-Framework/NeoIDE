<Project Sdk="Microsoft.NET.Sdk">
    <!-- Contract between NeoIDE and its plugins. Plugins reference this project with Private="false":
         the assembly is never shipped with a plugin, NeoIDE provides it at runtime. -->
    <PropertyGroup>
        <TargetFramework>net11.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>NeoIDE.Sdk</RootNamespace>
        <Version>1.0.0</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
</Project>
